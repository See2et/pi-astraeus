{
  "name": "@see2et/pi-astraeus",
  "version": "0.1.0",
  "private": true,
  "description": "Astraeus policy and evidence-bound review workflow for Pi",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/See2et/pi-astraeus.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "bun --bun husky",
    "format": "bun --bun oxfmt .",
    "format:check": "bun --bun oxfmt --check .",
    "lint": "bun --bun oxlint --deny-warnings .",
    "typecheck": "bun --bun tsc --noEmit",
    "architecture": "bun --bun depcruise --config .dependency-cruiser.cjs extensions src",
    "test": "bun --bun vitest run",
    "test:python": "python3 -m unittest discover -s tests/python -v",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run architecture && bun run test && bun run test:python",
    "precommit": "bun --bun lint-staged"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.0.4",
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@tintinweb/pi-subagents": "0.19.0",
    "@types/node": "26.6.4",
    "dependency-cruiser": "18.7.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "bun --bun oxfmt",
      "bun --bun oxlint --deny-warnings"
    ],
    "*.json": [
      "bun --bun oxfmt"
    ]
  },
  "engines": {
    "bun": ">=1.3.13",
    "node": ">=22"
  },
  "packageManager": "pnpm@11.25.0",
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
